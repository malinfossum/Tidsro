<Window x:Class="Tidsro.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="360" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource FontSans}">
  <StackPanel Margin="24">
    <CheckBox Content="Launch Tidsro at startup" IsChecked="{Binding LaunchAtStartup}"
              Style="{StaticResource ToggleSwitch}"
              AutomationProperties.Name="Launch at startup" Margin="0,0,0,20"/>
    <TextBlock Text="Default sound for new timers" Margin="0,0,0,8"/>
    <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding DefaultSound}"
              AutomationProperties.Name="Default sound">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Converter={StaticResource SoundLabel}}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <!-- Sits under the picker it feeds: "My sound" only appears in the dropdowns once a file is
         chosen here. Choosing copies the file at once, so this is outside the Save/Cancel draft. -->
    <TextBlock Text="My sound" Margin="0,20,0,4" Foreground="{StaticResource TextMuted}"
               FontWeight="SemiBold"/>
    <TextBlock Text="Use your own .wav for timers and alarms. Applies immediately; Cancel will not undo it."
               TextWrapping="Wrap" Foreground="{StaticResource TextFaint}"
               FontSize="{StaticResource TextXs}" Margin="0,0,0,8"/>
    <!-- No AutomationProperties.Name: it would REPLACE the accessible name a TextBlock gets from its
         own Text, so a screen reader would announce the label and never the file that was chosen. -->
    <TextBlock Text="{Binding CustomSoundLabel}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal">
      <Button Content="Choose .wav…" Style="{StaticResource QuietAction}" MinWidth="120"
              Command="{Binding ChooseCustomSoundCommand}"
              AutomationProperties.Name="Choose a custom sound"/>
      <!-- Hidden, not merely disabled, until there is a sound to act on: QuietAction has no dimmed
           state, so a disabled button here reads as clickable and does nothing. -->
      <Button Content="&#xE768;" Width="40" Margin="8,0,0,0" Style="{StaticResource QuietAction}"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              Command="{Binding PreviewCustomSoundCommand}"
              Visibility="{Binding HasCustomSound, Converter={StaticResource BoolToVisible}}"
              ToolTip="Preview sound" AutomationProperties.Name="Preview custom sound"/>
      <Button Content="Remove" Style="{StaticResource QuietAction}" MinWidth="84" Margin="8,0,0,0"
              Command="{Binding RemoveCustomSoundCommand}"
              Visibility="{Binding HasCustomSound, Converter={StaticResource BoolToVisible}}"
              AutomationProperties.Name="Remove the custom sound"/>
    </StackPanel>

    <Separator Margin="0,24,0,0" Background="{StaticResource TextMuted}" Opacity="0.3"/>
    <TextBlock Text="Data" Margin="0,16,0,4" Foreground="{StaticResource TextMuted}"
               FontWeight="SemiBold"/>
    <TextBlock Text="These take effect immediately. Cancel will not undo them."
               TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource Text}"/>
    <Button Content="Export data…" Style="{StaticResource QuietAction}"
            HorizontalAlignment="Left" MinWidth="150" Margin="0,0,0,8"
            Command="{Binding ExportDataCommand}"
            AutomationProperties.Name="Export data to a file"/>
    <Button Content="Import data…" Style="{StaticResource QuietAction}"
            HorizontalAlignment="Left" MinWidth="150" Margin="0,0,0,8"
            Command="{Binding ImportDataCommand}"
            AutomationProperties.Name="Import data from a file"/>
    <Button Content="Clear all alarms" Style="{StaticResource QuietAction}"
            HorizontalAlignment="Left" MinWidth="150" Margin="0,0,0,8"
            Command="{Binding ClearAlarmsCommand}"
            AutomationProperties.Name="Clear all alarms"/>
    <Button Content="Reset all settings" Style="{StaticResource QuietAction}"
            HorizontalAlignment="Left" MinWidth="150"
            Command="{Binding ResetSettingsCommand}"
            AutomationProperties.Name="Reset all settings"/>
    <TextBlock Text="Typeface: IBM Plex, © IBM Corp., SIL Open Font License 1.1"
               Foreground="{StaticResource TextFaint}" FontSize="{StaticResource TextXs}"
               TextWrapping="Wrap" Margin="0,16,0,0"
               AutomationProperties.Name="Typeface: IBM Plex, copyright IBM Corp., SIL Open Font License 1.1"/>
    <!-- The acknowledgement alone does not discharge OFL 1.1 §2: the licence itself has to travel
         with the fonts, and the portable exe travels alone. This reads the embedded OFL.txt. -->
    <Button Content="View font licence" Style="{StaticResource QuietAction}"
            HorizontalAlignment="Left" Margin="0,8,0,0" Click="ViewLicence_Click"
            AutomationProperties.Name="View font licence"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Save" Style="{StaticResource GoldAction}" IsDefault="True"
              MinWidth="84" Margin="0,0,8,0" Click="Save_Click"
              AutomationProperties.Name="Save settings"/>
      <Button Content="Cancel" Style="{StaticResource QuietAction}" IsCancel="True"
              MinWidth="84"
              AutomationProperties.Name="Cancel and discard changes"/>
    </StackPanel>
  </StackPanel>
</Window>
